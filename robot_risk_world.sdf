<?xml version="1.0"?>
<sdf version="1.6">
  <world name="robot_risk_world">

    <gravity>0 0 -9.8</gravity>

    <plugin filename="libignition-gazebo6-physics-system.so"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo6-user-commands-system.so"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo6-scene-broadcaster-system.so"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo6-sensors-system.so"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <direction>-0.4 0.2 -1</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <!-- Floor -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 5 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 5 0.1</size></box></geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.05 0 0 0</pose>
    </model>

    <!-- Obstacle 1 -->
    <model name="obstacle_1">
      <static>true</static>
      <pose>-1.0 0.0 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.35 0.8 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.35 0.8 0.9</size></box></geometry>
          <material>
            <ambient>0.85 0.15 0.1 1</ambient>
            <diffuse>0.85 0.15 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 2 -->
    <model name="obstacle_2">
      <static>true</static>
      <pose>1.0 0.8 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.7</size></box></geometry>
          <material>
            <ambient>0.9 0.55 0.1 1</ambient>
            <diffuse>0.9 0.55 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- One stationary person -->
    <model name="standing_person">
      <static>true</static>
      <pose>2.0 -0.35 0 0 0 0</pose>
      <link name="body">
        <visual name="torso">
          <pose>0 0 0.85 0 0 0</pose>
          <geometry><box><size>0.32 0.22 0.65</size></box></geometry>
          <material>
            <ambient>0.15 0.3 0.85 1</ambient>
            <diffuse>0.15 0.3 0.85 1</diffuse>
          </material>
        </visual>
        <collision name="torso_collision">
          <pose>0 0 0.85 0 0 0</pose>
          <geometry><box><size>0.32 0.22 0.65</size></box></geometry>
        </collision>
        <visual name="head">
          <pose>0 0 1.3 0 0 0</pose>
          <geometry><sphere><radius>0.14</radius></sphere></geometry>
          <material>
            <ambient>0.8 0.62 0.45 1</ambient>
            <diffuse>0.8 0.62 0.45 1</diffuse>
          </material>
        </visual>
        <collision name="head_collision">
          <pose>0 0 1.3 0 0 0</pose>
          <geometry><sphere><radius>0.14</radius></sphere></geometry>
        </collision>
        <visual name="left_leg">
          <pose>0 0.07 0.32 0 0 0</pose>
          <geometry><box><size>0.12 0.1 0.55</size></box></geometry>
          <material><ambient>0.15 0.15 0.2 1</ambient><diffuse>0.15 0.15 0.2 1</diffuse></material>
        </visual>
        <visual name="right_leg">
          <pose>0 -0.07 0.32 0 0 0</pose>
          <geometry><box><size>0.12 0.1 0.55</size></box></geometry>
          <material><ambient>0.15 0.15 0.2 1</ambient><diffuse>0.15 0.15 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Differential-drive robot -->
    <model name="risk_robot">
      <pose>-5.0 0 0 0 0 0</pose>
      <link name="chassis">
        <pose>0 0 0.22 0 0 0</pose>
        <inertial>
          <mass>8</mass>
          <inertia>
            <ixx>0.12</ixx><iyy>0.18</iyy><izz>0.22</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="chassis_collision">
          <geometry><box><size>0.45 0.32 0.14</size></box></geometry>
        </collision>
        <visual name="chassis_visual">
          <geometry><box><size>0.45 0.32 0.14</size></box></geometry>
          <material>
            <ambient>0.1 0.65 0.25 1</ambient>
            <diffuse>0.1 0.65 0.25 1</diffuse>
          </material>
        </visual>

        <!-- heading marker (yellow, front-top) and camera mast: visual only -->
        <visual name="heading_marker">
          <pose>0.17 0 0.08 0 0 0</pose>
          <geometry><box><size>0.10 0.20 0.02</size></box></geometry>
          <material><ambient>1 0.85 0 1</ambient><diffuse>1 0.85 0 1</diffuse></material>
        </visual>
        <visual name="camera_mast">
          <pose>0.18 0 0.27 0 0 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.36</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <visual name="camera_body">
          <pose>0.19 0 0.45 0 0.10 0</pose>
          <geometry><box><size>0.06 0.10 0.05</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>

        <!-- front caster: frictionless sphere, collision only on chassis (no extra mass/joint) -->
        <collision name="front_caster_collision">
          <pose>0.15 0 -0.143 0 0 0</pose>
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <surface>
            <friction>
              <ode><mu>0.0</mu><mu2>0.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="front_caster_visual">
          <pose>0.15 0 -0.143 0 0 0</pose>
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>

        <!-- rear caster: frictionless sphere, collision only on chassis (no extra mass/joint) -->
        <collision name="rear_caster_collision">
          <pose>-0.15 0 -0.143 0 0 0</pose>
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <surface>
            <friction>
              <ode><mu>0.0</mu><mu2>0.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="rear_caster_visual">
          <pose>-0.15 0 -0.143 0 0 0</pose>
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>

        <!-- Camera mounted at the front of the robot -->
        <sensor name="front_camera" type="camera">
          <pose>0.23 0 0.45 0 0.10 0</pose>
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <visualize>true</visualize>
          <topic>/robot_risk/camera</topic>
          <camera>
            <horizontal_fov>1.05</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.1</near><far>15</far></clip>
          </camera>
        </sensor>
      </link>

      <link name="left_wheel">
        <pose>0 0.21 0.12 1.5708 0 0</pose>
        <inertial>
          <mass>0.6</mass>
          <inertia>
            <ixx>0.004</ixx><iyy>0.004</iyy><izz>0.004</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.12</radius><length>0.06</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.12</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>

      <link name="right_wheel">
        <pose>0 -0.21 0.12 1.5708 0 0</pose>
        <inertial>
          <mass>0.6</mass>
          <inertia>
            <ixx>0.004</ixx><iyy>0.004</iyy><izz>0.004</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.12</radius><length>0.06</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.12</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent><child>left_wheel</child>
        <axis><xyz>0 0 -1</xyz><limit><effort>20</effort><velocity>30</velocity></limit></axis>
      </joint>
      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent><child>right_wheel</child>
        <axis><xyz>0 0 -1</xyz><limit><effort>20</effort><velocity>30</velocity></limit></axis>
      </joint>

      <plugin filename="ignition-gazebo-diff-drive-system"
              name="ignition::gazebo::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.42</wheel_separation>
        <wheel_radius>0.12</wheel_radius>
        <topic>/robot_risk/cmd_vel</topic>
        <odom_topic>/robot_risk/odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <max_linear_velocity>0.4</max_linear_velocity>
        <max_angular_velocity>1.0</max_angular_velocity>
      </plugin>
    </model>

    <!-- External overview camera (NOT the robot camera): video only -->
    <model name="overview_camera">
      <static>true</static>
      <pose>-0.6 -7.6 5.4 0 0.6 1.5708</pose>
      <link name="link">
        <sensor name="overview" type="camera">
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <topic>/robot_risk/overview_camera</topic>
          <camera>
            <horizontal_fov>1.22</horizontal_fov>
            <image><width>960</width><height>540</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>40</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
